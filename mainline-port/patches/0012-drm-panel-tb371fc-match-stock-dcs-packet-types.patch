+static void tb371fc_dsi_dcs_long_write_multi(
+	struct mipi_dsi_multi_context *ctx, struct mipi_dsi_device *dsi,
+	const void *data, size_t len)
+{
+	const struct mipi_dsi_host_ops *ops = dsi->host->ops;
+	struct mipi_dsi_msg msg = {
+		.channel = dsi->channel,
+		.type = MIPI_DSI_DCS_LONG_WRITE,
+		.tx_buf = data,
+		.tx_len = len,
+	};
+	ssize_t ret;
+
+	if (ctx->accum_err)
+		return;
+
+	if (!ops || !ops->transfer) {
+		ctx->accum_err = -ENOSYS;
+		return;
+	}
+
+	if (dsi->mode_flags & MIPI_DSI_MODE_LPM)
+		msg.flags |= MIPI_DSI_MSG_USE_LPM;
+
+	ret = ops->transfer(dsi->host, &msg);
+	if (ret < 0) {
+		ctx->accum_err = ret;
+		dev_err(&dsi->dev, "sending TB371FC long DCS data %*ph failed: %zd\n",
+			(int)len, data, ret);
+	}
+}
+
+static void tb371fc_dsi_dual_dcs_long_write_multi(
+	struct mipi_dsi_multi_context *ctx, struct mipi_dsi_device *dsi0,
+	struct mipi_dsi_device *dsi1, const void *data, size_t len)
+{
+	tb371fc_dsi_dcs_long_write_multi(ctx, dsi0, data, len);
+	tb371fc_dsi_dcs_long_write_multi(ctx, dsi1, data, len);
+}
+
+#define tb371fc_dsi_dual_dcs_long_write_seq_multi(ctx, dsi0, dsi1, seq...) \
+	do {                                                                  \
+		static const u8 d[] = { seq };                                  \
+		tb371fc_dsi_dual_dcs_long_write_multi(ctx, dsi0, dsi1, d,       \
+						 ARRAY_SIZE(d));                  \
+	} while (0)
+
