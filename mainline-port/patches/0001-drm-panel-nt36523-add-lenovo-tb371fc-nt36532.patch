+	.hdisplay = 1472 * 2, \
+	.hsync_start = (1472 + 201) * 2, \
+	.hsync_end = (1472 + 201 + 12) * 2, \
+	.htotal = (1472 + 201 + 12 + 60) * 2, \
+	.vdisplay = 1840, \
+	.vsync_start = 1840 + (_vfp), \
+	.vsync_end = 1840 + (_vfp) + 2, \
+	.vtotal = 1840 + (_vfp) + 2 + 182, \
+	.width_mm = 274, \
+	.height_mm = 171, \
+}
