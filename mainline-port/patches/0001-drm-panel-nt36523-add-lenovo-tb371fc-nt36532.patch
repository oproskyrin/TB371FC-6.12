+static int tb371fc_boe_init_sequence(struct panel_info *pinfo)
+{
+	return tb371fc_nt36532_init_sequence(pinfo, true);
+}
+
+static int tb371fc_tianma_init_sequence(struct panel_info *pinfo)
+{
+	return tb371fc_nt36532_init_sequence(pinfo, false);
+}
