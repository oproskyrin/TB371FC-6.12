+static const struct drm_display_mode tb371fc_modes[] = {
+	TB371FC_MODE(120, 26),
+	TB371FC_MODE(144, 26),
+	TB371FC_MODE(60, 2076),
+	TB371FC_MODE(30, 6176),
+};
