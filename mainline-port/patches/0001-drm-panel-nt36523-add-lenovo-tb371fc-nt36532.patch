 	struct mipi_dsi_device *dsi = pinfo->dsi[0];
@@ -914,6 +969,45 @@ static const struct drm_display_mode elish_csot_modes[] = {
 	},
 };
 
+#define TB371FC_MODE(_refresh, _vfp) { \
