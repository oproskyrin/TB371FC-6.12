+	/* Two 736-pixel DSC slices are carried by each 1472-pixel DSI link. */
+	.slice_count = 2,
+	.bits_per_component = 8,
+	.bits_per_pixel = 8 << 4,
+	.block_pred_enable = true,
+};
+
+#define TB371FC_DESC(_init) { \
+	.modes = tb371fc_modes, \
