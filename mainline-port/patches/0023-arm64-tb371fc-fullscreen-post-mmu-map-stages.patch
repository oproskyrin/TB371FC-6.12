From: TB371FC Linux bring-up <tb371fc@example.invalid>
Subject: [PATCH] arm64: tb371fc: make post-MMU map stages fullscreen

Replace the narrow post-MMU bands with unambiguous fullscreen markers.
This separates return from __enable_mmu, entry into __pi_early_map_kernel,
return from that routine, and entry into __primary_switched.
---
 arch/arm64/kernel/head.S | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/kernel/head.S b/arch/arm64/kernel/head.S
--- a/arch/arm64/kernel/head.S
+++ b/arch/arm64/kernel/head.S
@@ -317,3 +317,3 @@ SYM_FUNC_START_LOCAL(__primary_switched)
 #ifdef CONFIG_TB371FC_EARLY_FB_MARKER
-	tb371fc_early_fb_band 0x9d14, 0x0000, 0xff80, 0xff00
+	tb371fc_mmu_stage 0xffff, 0x0000, 91
 #endif
@@ -655,3 +655,3 @@ SYM_FUNC_START_LOCAL(__primary_switch)
 #ifdef CONFIG_TB371FC_EARLY_FB_MARKER
-	tb371fc_early_fb_band 0x9d14, 0x0000, 0xffff, 0x8000
+	tb371fc_mmu_stage 0xffff, 0x0000, 81
 #endif
@@ -663,3 +663,3 @@ SYM_FUNC_START_LOCAL(__primary_switch)
 #ifdef CONFIG_TB371FC_EARLY_FB_MARKER
-	tb371fc_early_fb_band 0x9d14, 0x0000, 0xff80, 0x00ff
+	tb371fc_mmu_stage 0xff00, 0xff00, 82
 #endif
@@ -670,3 +670,3 @@ SYM_FUNC_START_LOCAL(__primary_switch)
 #ifdef CONFIG_TB371FC_EARLY_FB_MARKER
-	tb371fc_early_fb_band 0x9d14, 0x0000, 0xff80, 0x8080
+	tb371fc_mmu_stage 0xff00, 0x0000, 83
 #endif
-- 
