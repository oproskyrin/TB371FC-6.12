# Core boot and early diagnostics
CONFIG_LOCALVERSION="-tb371fc"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FW_LOADER=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
# Lenovo's stock ARM64 Image has a direct branch in code0. Its ABL returns to
# fastboot before entering our EFI-stub Image, whose code0 starts with the
# PE/COFF-compatible MZ instruction. Android boot/recovery does not require the
# EFI stub, so keep the diagnostic payload in the stock-compatible form.
# CONFIG_EFI is not set
# KASLR is disabled only for deterministic first-instruction bring-up. Restore
# it after the mainline kernel reaches the diagnostic initramfs repeatedly.
# CONFIG_RANDOMIZE_BASE is not set
CONFIG_TB371FC_EARLY_FB_MARKER=y
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=-1
CONFIG_QCOM_WDT=y

# Qualcomm SM8250 platform
CONFIG_ARCH_QCOM=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_OCMEM=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_Q6V5_ADSP=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_Q6V5_MSS=y
CONFIG_QCOM_Q6V5_WCSS=y
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_QCOM_GENI_SE=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_SPI_QCOM_GENI=y

# Storage
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_UTF8=y

# Display and GPU
CONFIG_DRM=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DP=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_PANEL_NOVATEK_NT36523=y
CONFIG_BACKLIGHT_TB371FC_KTZ8866=y

# USB-C, role switching, DisplayPort PHY and analog audio switch
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_TYPEC=y
CONFIG_TYPEC_QCOM_PMIC=y
CONFIG_TYPEC_DP_ALTMODE=y
CONFIG_TYPEC_MUX_FSA4480=y
CONFIG_TYPEC_MUX_NB7VPQ904M=y
CONFIG_PHY_QCOM_QMP_COMBO=y

# Battery and charging telemetry
CONFIG_POWER_SUPPLY=y
CONFIG_FUEL_GAUGE_MM8013=y

# QCA6390 Wi-Fi and Bluetooth
CONFIG_PCI=y
CONFIG_PCIE_QCOM=y
CONFIG_MHI_BUS=y
CONFIG_WLAN=y
CONFIG_ATH11K=y
CONFIG_ATH11K_PCI=y
CONFIG_BT=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_QCA=y

# Audio base and downstream-derived TFA9894 codec transport. The four speaker
# nodes remain disabled until the fitted QS/YC acoustic variant is identified.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_SM8250=y
CONFIG_SND_SOC_TFA98XX=m

# Novatek SPI touch and AP500U pen transport
CONFIG_INPUT=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_INPUT_TABLET=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_MULTITOUCH=y
CONFIG_I2C_HID=y
CONFIG_I2C_HID_CORE=y
CONFIG_I2C_HID_OF=y
CONFIG_TOUCHSCREEN_NT36523_SPI=m

# Camera host and the only stock rear-sensor candidate already supported by
# mainline. Sensor nodes remain disabled until the fitted module is identified.
CONFIG_MEDIA_SUPPORT=y
CONFIG_CEC_CORE=y
CONFIG_VIDEO_QCOM_CAMSS=m
CONFIG_VIDEO_GC08A3=m
CONFIG_VIDEO_S5K4H7=m

# Snapdragon 870 / SM8250 uses the conventional 48-bit arm64 translation
# regime.  Keep the bring-up kernel away from the optional 52-bit VA/PA LPA2
# fallback path: r12 reached cpu_uninstall_idmap() and then reset while the
# previous build was configured for five-level 52-bit page tables.
CONFIG_ARM64_VA_BITS_48=y
# CONFIG_ARM64_VA_BITS_52 is not set
CONFIG_ARM64_PA_BITS_48=y
# CONFIG_ARM64_PA_BITS_52 is not set
# CONFIG_ARM64_LPA2 is not set
