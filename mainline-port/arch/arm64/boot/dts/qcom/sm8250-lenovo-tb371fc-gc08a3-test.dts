// SPDX-License-Identifier: GPL-2.0-only
/*
 * Temporary, non-installable TB371FC rear GC08A3 identification variant.
 *
 * Boot this DTB only after Android inventory identifies the QTECH GC08A3
 * module. It enables CAMSS, CCI0 master 0 and the three sensor rails; it does
 * not enable the actuator, EEPROM or flash. Never replace the normal DTB with
 * this file and never flash it to a boot slot.
 */

#include <dt-bindings/media/video-interfaces.h>
#include "sm8250-lenovo-tb371fc.dts"

/ {
	model = "Lenovo Xiaoxin Pad Pro 12.7 TB371FC (GC08A3 diagnostic)";
};

/* Stock PM8150 L13 rear analog rail: 2.8 V. */
&vreg_l13a_3p0 {
	regulator-min-microvolt = <2800000>;
	regulator-max-microvolt = <2800000>;
};

/* Downstream PM8150A is represented by mainline PM8150B/suffix c. */
&vreg_l3c_0p8 {
	regulator-min-microvolt = <1200000>;
	regulator-max-microvolt = <1200000>;
};

&vreg_l5c_1p8 {
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <1800000>;
};

&camss {
	vdda-phy-supply = <&vreg_l5a_0p88>;
	vdda-pll-supply = <&vreg_l9a_1p2>;
	status = "okay";

	ports {
		port@0 {
			camss_csiphy0_ep: endpoint {
				bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
				clock-lanes = <7>;
				data-lanes = <0 1 2 3>;
				remote-endpoint = <&gc08a3_ep>;
			};
		};
	};
};

&cci0 {
	status = "okay";
};

&cci0_i2c0 {
	gc08a3: camera@31 {
		compatible = "galaxycore,gc08a3";
		reg = <0x31>;

		clocks = <&camcc CAM_CC_MCLK0_CLK>;
		assigned-clocks = <&camcc CAM_CC_MCLK0_CLK>;
		assigned-clock-rates = <24000000>;

		pinctrl-names = "default";
		pinctrl-0 = <&cam0_default>;
		reset-gpios = <&tlmm 93 GPIO_ACTIVE_LOW>;

		avdd-supply = <&vreg_l13a_3p0>;
		dvdd-supply = <&vreg_l3c_0p8>;
		dovdd-supply = <&vreg_l5c_1p8>;

		port {
			gc08a3_ep: endpoint {
				clock-lanes = <0>;
				data-lanes = <1 2 3 4>;
				link-frequencies = /bits/ 64 <336000000>;
				remote-endpoint = <&camss_csiphy0_ep>;
			};
		};
	};
};

&tlmm {
	cam0_default: cam0-default-state {
		reset-pins {
			pins = "gpio93";
			function = "gpio";
			drive-strength = <2>;
			bias-pull-down;
		};

		mclk-pins {
			pins = "gpio94";
			function = "cam_mclk";
			drive-strength = <16>;
			bias-disable;
		};
	};
};
