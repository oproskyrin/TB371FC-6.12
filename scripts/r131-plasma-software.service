[Unit]
Description=TB371FC reversible Plasma test on inherited simpledrm
After=systemd-logind.service
Wants=systemd-logind.service

[Service]
Type=simple
User=alarm
PAMName=login
WorkingDirectory=/home/alarm
TTYPath=/dev/tty2
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
UtmpIdentifier=tty2
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_SESSION_DESKTOP=KDE
Environment=XDG_CURRENT_DESKTOP=KDE
Environment=XDG_SEAT=seat0
Environment=XDG_VTNR=2
Environment=KWIN_DRM_DEVICES=/dev/dri/card0
Environment=KWIN_COMPOSE=Q
Environment=LIBGL_ALWAYS_SOFTWARE=1
Environment=QT_QUICK_BACKEND=software
Environment=QT_LOGGING_RULES=kwin_core.debug=true;kwin_wayland_drm.debug=true
ExecStart=/usr/bin/dbus-run-session /usr/bin/startplasma-wayland
TimeoutStopSec=15s
Restart=no
