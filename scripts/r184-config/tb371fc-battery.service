[Unit]
Description=TB371FC battery fuel gauge (Mitsumi MM8013 on i2c3)
Before=upower.service
ConditionPathExists=/proc/device-tree/soc@0/geniqup@9c0000/i2c@98c000/fuel-gauge@55

[Service]
Type=oneshot
RemainAfterExit=yes
# R184-R186 kernels: CONFIG_FUEL_GAUGE_MM8013 off, module from prepare-r184-battery-dt.sh; R187+: built in
ExecStart=/bin/sh -c '[ -d /sys/bus/i2c/drivers/mm8013 ] || insmod /usr/local/lib/tb371fc/mm8013.ko'

[Install]
WantedBy=multi-user.target
