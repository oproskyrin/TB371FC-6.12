#!/bin/sh
# Launch one application through Zink -> Turnip -> KGSL on TB371FC V56.7.
# The Plasma desktop deliberately stays on llvmpipe/SDE because the downstream
# 4.19 display and render nodes do not provide reliable cross-device fencing.
set -eu

kgsl_icd=/opt/tb371fc-mesa-kgsl-26.1.7/share/vulkan/icd.d/freedreno_icd.aarch64.json
patched_mesa=/opt/tb371fc-mesa-zink-patched

if [ "$#" -eq 0 ]; then
	echo "usage: tb371fc-run-gpu PROGRAM [ARG ...]" >&2
	exit 64
fi
if [ ! -c /dev/kgsl-3d0 ] || [ ! -r "$kgsl_icd" ] || \
		[ ! -r "$patched_mesa/lib/libgallium-26.1.7.so" ]; then
	echo "TB371FC hardware rendering stack is unavailable" >&2
	exit 69
fi

unset LIBGL_ALWAYS_SOFTWARE QT_QUICK_BACKEND QSG_RHI_BACKEND
export TB371FC_ZINK_KGSL_ALLOW_UNMATCHED=1
export LIBGL_DRIVERS_PATH="$patched_mesa/lib/dri"
export LD_LIBRARY_PATH="$patched_mesa/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export __EGL_VENDOR_LIBRARY_FILENAMES="$patched_mesa/share/glvnd/egl_vendor.d/50_mesa.json"
export VK_ICD_FILENAMES="$kgsl_icd"
export VK_DRIVER_FILES="$kgsl_icd"
export MESA_LOADER_DRIVER_OVERRIDE=zink
export GALLIUM_DRIVER=zink
export TU_DEBUG=noconform
export MESA_VK_WSI_DEBUG=sw

exec "$@"
