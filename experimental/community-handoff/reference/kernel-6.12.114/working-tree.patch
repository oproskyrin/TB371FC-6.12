+
+void __init __no_sanitize_address
+tb371fc_start_kernel_fb_marker(u32 color, u32 stage)
+{
+	volatile u32 *pixel = tb371fc_fb_marker_base ?
+		(volatile u32 *)tb371fc_fb_marker_base :
+		(volatile u32 *)(unsigned long)TB371FC_FB_MARKER_PHYS;
+	volatile u32 *stage_word = tb371fc_stage_word_base ?
+		(volatile u32 *)tb371fc_stage_word_base :
+		(volatile u32 *)(unsigned long)TB371FC_STAGE_WORD_PHYS;
+	volatile u32 *stage_backup = tb371fc_stage_backup_base ?
+		(volatile u32 *)tb371fc_stage_backup_base :
+		(volatile u32 *)(unsigned long)TB371FC_STAGE_BACKUP_PHYS;
+	unsigned long remaining = TB371FC_FB_STRIDE_PIXELS *
+				  tb371fc_fb_marker_rows;
+
+	while (remaining--)
+		*pixel++ = color;
+
+	stage_word[0] = 0x54423337;
+	stage_word[1] = stage;
+	stage_word[2] = ~stage;
+	stage_backup[0] = 0x54423337;
+	stage_backup[1] = stage;
+	stage_backup[2] = ~stage;
+	asm volatile("dsb sy" ::: "memory");
+}
+
+void __init __no_sanitize_address
+tb371fc_diag_write_region(u32 index, u64 start, u64 end)
+{
+	volatile u32 *stage_word = tb371fc_stage_word_base ?
+		(volatile u32 *)tb371fc_stage_word_base :
+		(volatile u32 *)(unsigned long)TB371FC_STAGE_WORD_PHYS;
+	volatile u32 *stage_backup = tb371fc_stage_backup_base ?
+		(volatile u32 *)tb371fc_stage_backup_base :
+		(volatile u32 *)(unsigned long)TB371FC_STAGE_BACKUP_PHYS;
+	u32 magic = 0x4d454d31; /* 'MEM1' */
+	u32 words[6];
+	int i;
+
+	words[0] = magic;
+	words[1] = index;
+	words[2] = (u32)(start & 0xffffffffUL);
+	words[3] = (u32)(start >> 32);
+	words[4] = (u32)(end & 0xffffffffUL);
+	words[5] = (u32)(end >> 32);
+	for (i = 0; i < 6; i++) {
+		stage_word[16 + i] = words[i];
+		stage_backup[16 + i] = words[i];
+	}
+	asm volatile("dsb sy" ::: "memory");
+}
+
+void __init __no_sanitize_address
+tb371fc_diag_write_barcode(u64 start)
+{
+	volatile u32 *fb = tb371fc_fb_marker_base ?
+		(volatile u32 *)tb371fc_fb_marker_base :
+		(volatile u32 *)(unsigned long)TB371FC_FB_MARKER_PHYS;
+	unsigned long rows = tb371fc_fb_marker_rows;
+	unsigned long stride = TB371FC_FB_STRIDE_PIXELS;
+	unsigned long seg = stride / 8;
+	unsigned long total = stride * rows;
+	volatile u32 *p;
+	int nibble, r;
+	unsigned long c;
+
+	p = fb;
+	while (total--)
+		*p++ = 0xff000000u;
+
+	for (nibble = 0; nibble < 8; nibble++) {
+		u32 val = (u32)((start >> ((7 - nibble) * 4)) & 0xf);
+		unsigned long col_start = (unsigned long)nibble * seg;
+		unsigned long bar_h = val + 1;
+
+		for (r = 0; r < (int)bar_h; r++) {
+			unsigned long row = rows - 1 - (unsigned long)r;
+
+			for (c = 0; c < seg; c++)
+				fb[row * stride + col_start + c] = 0xffffffffu;
+		}
+	}
+	asm volatile("dsb sy" ::: "memory");
+}
+
+static void __init tb371fc_map_fixmap_diagnostics(void)
+{
+	void __iomem *fb;
+	void __iomem *stage;
+	void __iomem *backup;
+
+	fb = early_ioremap(TB371FC_FB_MARKER_PHYS,
+			   TB371FC_FB_FIXMAP_SIZE);
+	stage = early_ioremap(TB371FC_STAGE_WORD_PHYS, PAGE_SIZE);
+	backup = early_ioremap(TB371FC_STAGE_BACKUP_PHYS, PAGE_SIZE);
+	if (fb) {
+		tb371fc_fb_marker_base = fb;
+		tb371fc_fb_marker_rows = TB371FC_FB_FIXMAP_ROWS;
+	}
+	if (stage)
+		tb371fc_stage_word_base = stage;
+	if (backup)
+		tb371fc_stage_backup_base = backup;
+}
