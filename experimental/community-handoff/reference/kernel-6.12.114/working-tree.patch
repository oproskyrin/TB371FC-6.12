+	 * reservation. The latter is not consumed by the framebuffer and is the
+	 * durable handoff to the V56.5 reader after a watchdog reset.
+	 */
+	.macro	tb371fc_early_fb_band addr_hi, addr_lo, color_hi, color_lo
+	movz	x1, #0x0000
+	movk	x1, #0x9c00, lsl #16
+	movz	w2, #\color_lo
+	movk	w2, #\color_hi, lsl #16
+	movz	x3, #0x5c00
+	nop
+.Ltb371fc_fill_splash\@:
+	stp	w2, w2, [x1], #8
+	subs	x3, x3, #1
+	b.ne	.Ltb371fc_fill_splash\@
+	dsb	sy
+	.endm
+
+	.macro	tb371fc_early_stage_word stage
+
+	.endm
+
+	/* Full-screen marker which preserves the __enable_mmu x0-x3 arguments. */
+	.macro	tb371fc_mmu_stage color_hi, color_lo, stage
+	movz	x6, #0x0000
+	movk	x6, #0x9c00, lsl #16
+	movz	w7, #\color_lo
+	movk	w7, #\color_hi, lsl #16
+	movz	x8, #0x5c00
+	nop
+.Ltb371fc_fill_mmu\@:
+	stp	w7, w7, [x6], #8
+	subs	x8, x8, #1
+	b.ne	.Ltb371fc_fill_mmu\@
+	.endm
+#endif
