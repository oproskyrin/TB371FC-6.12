+config TB371FC_EARLY_FB_MARKER
+	bool "TB371FC staged early framebuffer markers"
+	default n
+	help
+	  Paint diagnostic bands in the Lenovo TB371FC continuous-splash
+	  framebuffer and record the last reached boot stage in the unused
+	  framebuffer tail. This is only for early boot localization and must
+	  remain disabled in production kernels.
+
 source "drivers/hwtracing/coresight/Kconfig"
+
+config TB371FC_LATE_FB_MARKER
+	bool "TB371FC staged post-MMU framebuffer/scratch markers"
+	default n
+	help
+	  Paint diagnostic colour bands and record boot-stage/region
+	  diagnostics in fixed physical scratch memory (backed by
+	  early_ioremap, valid once the MMU is active) that survives a
+	  warm PSCI reset and can be read back afterwards. For early
+	  boot localization only; must remain disabled in production
+	  kernels.
+
+config TB371FC_POST_MMU_RESET_CHECKPOINT
+	bool "TB371FC single PSCI reset checkpoint right after MMU enable"
+	default n
+	help
+	  Issue a PSCI SYSTEM_RESET SMC call immediately after the SCTLR_EL1
+	  write in __enable_mmu, before any other instruction executes. Used
+	  to localize a kexec early-boot hang to before or after the MMU
+	  enable instant without relying on framebuffer writes, which are not
+	  valid once address translation is active. Must remain disabled in
+	  production kernels.
