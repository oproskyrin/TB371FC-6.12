#!/bin/sh

set -eu
payload_dir=/run/tb371fc-kexec
image=$payload_dir/Image
dtb=$payload_dir/tb371fc-display-test.dtb
initramfs=$payload_dir/initramfs.cpio.gz
kexec=/bin/kexec
[ -x "$kexec" ] || kexec=/run/tb371fc-rescue/kexec
[ -x "$kexec" ] || { echo 'kexec binary is unavailable' >&2; exit 1; }
busybox=busybox
[ ! -x /run/tb371fc-rescue/busybox ] || busybox=/run/tb371fc-rescue/busybox

verify() {
	file=$1
	expected=$2
	[ -s "$file" ] || { echo "missing payload: $file" >&2; exit 1; }
	actual=$("$busybox" sha256sum "$file" | "$busybox" awk '{print $1}')
	[ "$actual" = "$expected" ] || {
		echo "SHA-256 mismatch: $file" >&2
		echo "expected $expected" >&2
		echo "actual   $actual" >&2
		exit 1
	}
}

verify "$image" 0afcf25e382deafdc277d9fa10ffb8b62474fcbea297bda7c40d5778b36b6170
verify "$dtb" d41d9d67366c0a38a83317baf4b7d8c15854b05fd9e10947f45714d89808d9a9
verify "$initramfs" 423aeb496f5ff471073d52f444fc269c624055bee813239b8d87409ecf12bd2c

cmdline='earlycon=qcom_geni,0x988000 console=ttyMSM0,115200n8 console=tty0 fbcon=font:TER16x32 keep_bootcon ignore_loglevel initcall_debug drm.debug=0x1ff log_buf_len=4M rdinit=/init root=/dev/ram0 rw fw_devlink=permissive clk_ignore_unused pd_ignore_unused panic=-1 swiotlb=2048'
"$kexec" -u 2>/dev/null || true
"$kexec" -c -l "$image" --dtb="$dtb" --initrd="$initramfs" --append="$cmdline"
echo loaded >"$payload_dir/state"
echo 'Mainline 7.1.7 payload verified and loaded; it has NOT been executed.'
