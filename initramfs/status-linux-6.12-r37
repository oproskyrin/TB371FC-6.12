#!/bin/sh

payload=/run/tb371fc-rescue/linux-6.12-r37
state=$(cat /run/tb371fc-linux612-r37.state 2>/dev/null || echo not-loaded)
echo "TB371FC Linux 6.12 controlled loader r37: $state"
echo "first stage: $(uname -r)"
for file in Image board.dtb initramfs.cpio.gz; do
	if [ -s "$payload/$file" ]; then
		/run/tb371fc-rescue/busybox sha256sum "$payload/$file"
	else
		echo "missing: $payload/$file"
	fi
done
echo 'Load only: /run/tb371fc-rescue/load-linux-6.12-r37'
echo 'Execute:   /run/tb371fc-rescue/execute-linux-6.12-r37'
