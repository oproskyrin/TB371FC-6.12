#!/bin/sh

# TB371FC V53: proven simplefb, Arch on microSD and real OpenSSH tunneled over
# the physically proven USB ACM function. Android/UFS is never mounted.

export PATH=/sbin:/bin:/usr/sbin:/usr/bin

mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
busybox mkdir -p /proc /sys /run /tmp /dev/pts /sys/kernel/debug
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devpts devpts /dev/pts 2>/dev/null || true
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null || true
mount -t tmpfs tmpfs /run 2>/dev/null || true
mount -t tmpfs tmpfs /tmp 2>/dev/null || true

[ -c /dev/console ] || busybox mknod -m 600 /dev/console c 5 1
[ -c /dev/null ] || busybox mknod -m 666 /dev/null c 1 3
[ -c /dev/zero ] || busybox mknod -m 666 /dev/zero c 1 5
[ -c /dev/tty ] || busybox mknod -m 666 /dev/tty c 5 0

hostname tb371fc-community-v53
dmesg -n 8
busybox mkdir -p /run/tb371fc-v53 /run/tb371fc-rescue
echo starting >/run/tb371fc-v53/status

# V52 copied this only after successful NCM setup. Its photo proved Arch root
# verification succeeded but switch_root then failed because the copy was
# absent. Preserve the transition runtime unconditionally before USB setup.
busybox cp /bin/busybox /run/tb371fc-rescue/busybox || exec setsid cttyhack sh
busybox ln -sf busybox /run/tb371fc-rescue/sh

if /bin/setup-usb-acm-v53 >/run/tb371fc-v53/setup-usb.txt 2>&1; then
	echo acm-ready >/run/tb371fc-v53/usb-status
else
	echo acm-failed >/run/tb371fc-v53/usb-status
fi

for _ in $(busybox seq 1 30); do
	[ -r /sys/class/graphics/fb0/dev ] && break
	busybox sleep 1
done
if [ -r /sys/class/graphics/fb0/dev ] && [ ! -c /dev/fb0 ]; then
	devnum=$(busybox cat /sys/class/graphics/fb0/dev)
	major=${devnum%%:*}
	minor=${devnum##*:}
	busybox mknod -m 600 /dev/fb0 c "$major" "$minor"
fi

if [ -c /dev/fb0 ]; then
	echo simplefb-ready >/run/tb371fc-v53/status
	/bin/framebuffer-pattern /dev/fb0 >/run/tb371fc-v53/framebuffer-pattern.txt 2>&1 || true
else
	echo simplefb-missing >/run/tb371fc-v53/status
fi

busybox sleep 5
if [ -w /sys/module/printk/parameters/ignore_loglevel ]; then
	echo N >/sys/module/printk/parameters/ignore_loglevel
fi
dmesg -n 1
if [ -c /dev/tty0 ]; then
	usb_status=$(busybox cat /run/tb371fc-v53/usb-status 2>/dev/null || true)
	busybox printf '\033[2J\033[H' >/dev/tty0
	busybox printf 'TB371FC ARCH LINUX V53\n\n' >/dev/tty0
	busybox printf 'Internal display console: WORKING\n' >/dev/tty0
	busybox printf 'USB ACM transport: %s\n' "$usb_status" >/dev/tty0
	busybox printf 'Arch OpenSSH over COM tunnel: starting\n' >/dev/tty0
	busybox printf 'Persistent BusyBox transition: preserved\n\n' >/dev/tty0
	busybox printf 'No userspace DRM modeset.\n' >/dev/tty0
fi

busybox cat /proc/fb >/run/tb371fc-v53/proc-fb.txt 2>&1
busybox dmesg >/run/tb371fc-v53/dmesg.txt 2>&1
echo entering-arch-development-root >/run/tb371fc-v53/status
busybox sleep 3
exec /bin/boot-arch-development-rootfs

