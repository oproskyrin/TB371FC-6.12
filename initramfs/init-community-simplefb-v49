#!/bin/sh

# TB371FC community parallel-SSPP + simple-framebuffer visible-console test.
# The inherited display stream is never modeset from userspace. All files and
# the exported FAT log disk live in initramfs RAM; persistent storage is unused.

export PATH=/sbin:/bin:/usr/sbin:/usr/bin

mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
busybox mkdir -p /proc /sys /run /tmp /dev/pts /mnt/v49-logs
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devpts devpts /dev/pts 2>/dev/null || true
mount -t tmpfs tmpfs /run 2>/dev/null || true
mount -t tmpfs tmpfs /tmp 2>/dev/null || true

[ -c /dev/console ] || busybox mknod -m 600 /dev/console c 5 1
[ -c /dev/null ] || busybox mknod -m 666 /dev/null c 1 3
[ -c /dev/zero ] || busybox mknod -m 666 /dev/zero c 1 5
[ -b /dev/loop0 ] || busybox mknod -m 600 /dev/loop0 b 7 0

hostname tb371fc-community-simplefb
dmesg -n 8
busybox mkdir -p /run/v49-snapshots

capture_snapshot() {
	label=$1
	out=/run/v49-snapshots/$label
	busybox mkdir -p "$out"
	busybox uname -a >"$out/uname.txt" 2>&1
	busybox cat /proc/cmdline >"$out/cmdline.txt" 2>&1
	busybox cat /proc/uptime >"$out/uptime.txt" 2>&1
	busybox cat /proc/fb >"$out/proc-fb.txt" 2>&1
	busybox dmesg >"$out/dmesg.txt" 2>&1
	busybox ps >"$out/processes.txt" 2>&1
	busybox ls -l /dev/fb0 /dev/tty0 /sys/class/graphics /sys/class/drm \
		>"$out/display-nodes.txt" 2>&1
	{
		for node in /sys/class/graphics/* /sys/class/drm/* \
			/sys/class/backlight/*; do
			[ -e "$node" ] || continue
			echo "[$node -> $(busybox readlink -f "$node" 2>/dev/null)]"
			for field in name dev state status modes enabled uevent \
				stride bits_per_pixel virtual_size; do
				[ -r "$node/$field" ] || continue
				echo "-- $field"
				busybox cat "$node/$field" 2>/dev/null
			done
		done
	} >"$out/display-sysfs.txt" 2>&1
	{
		for node in /sys/class/regulator/regulator.*; do
			[ -d "$node" ] || continue
			name=$(busybox cat "$node/name" 2>/dev/null)
			case "$name" in
				display_panel_avdd|lcdb_ldo|lcdb_ncp|*backlight*)
					echo "[$node]"
					echo "name=$name"
					for field in state microvolts num_users; do
						[ -r "$node/$field" ] || continue
						echo "$field=$(busybox cat "$node/$field" 2>/dev/null)"
					done
					;;
			esac
		done
	} >"$out/display-regulators.txt" 2>&1
}

echo 'V49 community parallel SSPP; simplefb only; no userspace DRM modeset.' \
	>/run/v49-snapshots/README.txt

for _ in $(busybox seq 1 30); do
	[ -r /sys/class/graphics/fb0/dev ] && break
	busybox sleep 1
done

if [ -r /sys/class/graphics/fb0/dev ] && [ ! -c /dev/fb0 ]; then
	devnum=$(busybox cat /sys/class/graphics/fb0/dev)
	major=${devnum%%:*}
	minor=${devnum##*:}
	busybox mknod -m 660 /dev/fb0 c "$major" "$minor"
fi

capture_snapshot 00-before-pattern

if [ -c /dev/fb0 ]; then
	/bin/framebuffer-pattern /dev/fb0 \
		>/run/v49-snapshots/framebuffer-pattern.txt 2>&1
	echo $? >/run/v49-snapshots/framebuffer-pattern.exit
else
	echo 'simple framebuffer /dev/fb0 did not appear' \
		>/run/v49-snapshots/framebuffer-pattern.txt
	echo 1 >/run/v49-snapshots/framebuffer-pattern.exit
fi

busybox sleep 5
capture_snapshot 05-after-pattern

# Keep the large-font Linux status visible after the color-bar proof.
dmesg -n 1
if [ -c /dev/tty0 ]; then
	busybox printf '\033[2J\033[H' >/dev/tty0
	busybox printf 'TB371FC LINUX V49\n\n' >/dev/tty0
	busybox printf 'Parallel SSPP: enabled\n' >/dev/tty0
	busybox printf 'Simple framebuffer: /dev/fb0\n' >/dev/tty0
	busybox printf 'Resolution: 2944 x 1840\n' >/dev/tty0
	busybox printf 'No Android storage mounted\n\n' >/dev/tty0
	busybox printf 'Linux console is running.\n' >/dev/tty0
fi

busybox sleep 10
capture_snapshot 15-visible-console

busybox cp /bin/v45-logdisk-template.img /run/tb371fc-v49-logs.img
busybox losetup /dev/loop0 /run/tb371fc-v49-logs.img
mount -t vfat -o rw,noatime /dev/loop0 /mnt/v49-logs
busybox cp -a /run/v49-snapshots/. /mnt/v49-logs/
busybox sync
umount /mnt/v49-logs
busybox losetup -d /dev/loop0

mount -t configfs configfs /sys/kernel/config 2>/dev/null || true
gadget=/sys/kernel/config/usb_gadget/tb371fc_v49_logs
busybox mkdir -p "$gadget/strings/0x409" \
	"$gadget/configs/c.1/strings/0x409"
echo 0x1d6b >"$gadget/idVendor"
echo 0x0107 >"$gadget/idProduct"
echo TB371FC-V49-LOGS >"$gadget/strings/0x409/serialnumber"
echo TB371FC-Linux >"$gadget/strings/0x409/manufacturer"
echo 'TB371FC V49 simplefb logs' >"$gadget/strings/0x409/product"
echo 'Read-only log disk' >"$gadget/configs/c.1/strings/0x409/configuration"
busybox mkdir -p "$gadget/functions/mass_storage.0"
echo 1 >"$gadget/functions/mass_storage.0/lun.0/ro"
echo 1 >"$gadget/functions/mass_storage.0/lun.0/removable"
echo 1 >"$gadget/functions/mass_storage.0/lun.0/nofua" 2>/dev/null || true
echo /run/tb371fc-v49-logs.img >"$gadget/functions/mass_storage.0/lun.0/file"
busybox ln -s "$gadget/functions/mass_storage.0" \
	"$gadget/configs/c.1/mass_storage.0"
for udc_path in /sys/class/udc/*; do
	[ -e "$udc_path" ] || continue
	echo "${udc_path##*/}" >"$gadget/UDC"
	break
done

while :; do
	busybox sleep 60
done
