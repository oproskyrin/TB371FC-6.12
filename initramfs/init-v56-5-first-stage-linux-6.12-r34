#!/bin/sh

# TB371FC r34: boot the proven V56.5 vendor kernel first, then hand off to
# Linux 6.12 with arm64 kexec.  If verification/loading fails, continue into
# the known-good V56.5 Arch/KDE environment instead of leaving a dead screen.

export PATH=/sbin:/bin:/usr/sbin:/usr/bin

mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
busybox mkdir -p /proc /sys /run /tmp /dev/pts /sys/kernel/debug
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devpts devpts /dev/pts 2>/dev/null || true
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null || true
mount -t tmpfs tmpfs /run 2>/dev/null || true
mount -t tmpfs tmpfs /tmp 2>/dev/null || true

[ -c /dev/console ] || busybox mknod -m 600 /dev/console c 5 1
[ -c /dev/null ] || busybox mknod -m 666 /dev/null c 1 3
[ -c /dev/zero ] || busybox mknod -m 666 /dev/zero c 1 5
[ -c /dev/tty ] || busybox mknod -m 666 /dev/tty c 5 0

hostname tb371fc-first-stage-r34
dmesg -n 8
busybox mkdir -p /run/tb371fc-v56 /run/tb371fc-rescue
echo starting >/run/tb371fc-v56/status

busybox cp /bin/busybox /run/tb371fc-rescue/busybox || exec setsid cttyhack sh
busybox ln -sf busybox /run/tb371fc-rescue/sh

if /bin/setup-usb-acm-v56 >/run/tb371fc-v56/setup-usb.txt 2>&1; then
	echo acm-ready >/run/tb371fc-v56/usb-status
else
	echo acm-failed >/run/tb371fc-v56/usb-status
fi

for _ in $(busybox seq 1 30); do
	[ -r /sys/class/graphics/fb0/dev ] && break
	busybox sleep 1
done
if [ -r /sys/class/graphics/fb0/dev ] && [ ! -c /dev/fb0 ]; then
	devnum=$(busybox cat /sys/class/graphics/fb0/dev)
	major=${devnum%%:*}
	minor=${devnum##*:}
	busybox mknod -m 600 /dev/fb0 c "$major" "$minor"
fi

if [ -c /dev/fb0 ]; then
	echo simplefb-ready >/run/tb371fc-v56/status
	/bin/framebuffer-pattern /dev/fb0 >/run/tb371fc-v56/framebuffer-pattern.txt 2>&1 || true
else
	echo simplefb-missing >/run/tb371fc-v56/status
fi

busybox sleep 3
if [ -w /sys/module/printk/parameters/ignore_loglevel ]; then
	echo N >/sys/module/printk/parameters/ignore_loglevel
fi
dmesg -n 1
if [ -c /dev/tty0 ]; then
	usb_status=$(busybox cat /run/tb371fc-v56/usb-status 2>/dev/null || true)
	busybox printf '\033[2J\033[H' >/dev/tty0
	busybox printf 'TB371FC V56.5 FIRST-STAGE LOADER r34\n\n' >/dev/tty0
	busybox printf 'Known-good 4.19 display/USB: READY\n' >/dev/tty0
	busybox printf 'USB ACM transport: %s\n' "$usb_status" >/dev/tty0
	busybox printf 'Verifying embedded Linux 6.12 payload...\n' >/dev/tty0
fi

payload=/opt/tb371fc-linux-6.12-r34
image=$payload/Image
dtb=$payload/board.dtb
initrd=$payload/initramfs.cpio.gz
kexec=/bin/kexec
cmdline='console=tty0 fbcon=font:TER16x32 earlycon=qcom_geni,0x988000 keep_bootcon ignore_loglevel log_buf_len=8M rdinit=/init root=/dev/ram0 rw fw_devlink=permissive clk_ignore_unused pd_ignore_unused regulator_ignore_unused panic=-1 swiotlb=2048'

verify_file() {
	actual=$(busybox sha256sum "$1" 2>/dev/null | busybox awk '{print $1}')
	[ "$actual" = "$2" ]
}

handoff_error=''
[ "$(uname -r)" = '4.19.157-perf-v56.5+' ] || handoff_error='unexpected first-stage kernel'
[ -x "$kexec" ] || handoff_error='kexec binary missing'
verify_file "$image" c64314f9abc82d7cea21d26ddea7645905e2ff717ed76cdd1c3b2ff718c4517f || handoff_error='Linux 6.12 Image checksum mismatch'
verify_file "$dtb" caa9598e88b9b4a39d39916651d306824e2f44d8325822e510bcb6d0cede357c || handoff_error='Linux 6.12 DTB checksum mismatch'
verify_file "$initrd" c807299d26b83c2d585a1ae8402dfbb68852a647ed153bf190123e9a7048dd9c || handoff_error='Linux 6.12 initramfs checksum mismatch'

if [ -z "$handoff_error" ]; then
	"$kexec" -u 2>/dev/null || true
	if "$kexec" -c -l "$image" --dtb="$dtb" --initrd="$initrd" --append="$cmdline" \
		>/run/tb371fc-v56/kexec-load.txt 2>&1; then
		echo loaded-linux-6.12-r34 >/run/tb371fc-v56/status
		if [ -c /dev/tty0 ]; then
			busybox printf 'Linux 6.12 verified and loaded. Handoff in 5 seconds.\n' >/dev/tty0
		fi
		busybox dmesg >/run/tb371fc-v56/dmesg-before-kexec.txt 2>&1
		sync
		busybox sleep 5
		"$kexec" -e
		handoff_error='kexec returned unexpectedly'
	else
		handoff_error='kexec load failed'
	fi
fi

echo "$handoff_error" >/run/tb371fc-v56/kexec-error.txt
if [ -c /dev/tty0 ]; then
	busybox printf 'Linux 6.12 handoff failed: %s\n' "$handoff_error" >/dev/tty0
	busybox printf 'Falling back to the known-good V56.5 Arch/KDE system.\n' >/dev/tty0
fi
busybox sleep 5
exec /bin/boot-arch-development-rootfs
