# Clean 39-bit VA bring-up profile for the V56.5 kexec handoff.
# Deliberately excludes TB371FC_EARLY_FB_MARKER: physical framebuffer writes
# are unsafe after SCTLR_EL1.M enables translation.
CONFIG_LOCALVERSION="-tb371fc-arch612-clean39"
CONFIG_ARM64_VA_BITS_39=y
# CONFIG_ARM64_VA_BITS_48 is not set
# CONFIG_ARM64_VA_BITS_52 is not set
CONFIG_ARM64_VA_BITS=39
CONFIG_ARM64_PA_BITS_48=y
# CONFIG_ARM64_PA_BITS_52 is not set
CONFIG_ARM64_PA_BITS=48
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_TB371FC_EARLY_FB_MARKER is not set
