# Diagnostic override for a V56.5-compatible ARM64 translation regime.
# This profile is for early handoff localization only, not production.
CONFIG_LOCALVERSION="-tb371fc-arch612-diag39"
CONFIG_ARM64_VA_BITS_39=y
# CONFIG_ARM64_VA_BITS_48 is not set
# CONFIG_ARM64_VA_BITS_52 is not set
CONFIG_ARM64_VA_BITS=39
CONFIG_ARM64_PA_BITS_48=y
# CONFIG_ARM64_PA_BITS_52 is not set
CONFIG_ARM64_PA_BITS=48
# CONFIG_RANDOMIZE_BASE is not set
CONFIG_TB371FC_EARLY_FB_MARKER=y
