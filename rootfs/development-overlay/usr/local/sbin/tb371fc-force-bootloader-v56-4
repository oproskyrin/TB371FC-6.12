#!/bin/sh
# Bypass downstream device_shutdown after a separate successful sync.
set -u

required_token=V56_4_LOGS_COPIED_FORCE_BOOTLOADER
module=/usr/local/lib/tb371fc/reboot-bootloader-emergency-v56.4.ko
expected=de5f6798e0a8b7e704793a58fcee9c17676c1d0c2c6dc3668bff738b678449ef

if [ "$#" -ne 1 ] || [ "$1" != "$required_token" ]; then
	echo "Refusing direct restart. Required token: $required_token" >&2
	exit 2
fi
[ "$(/usr/bin/uname -r)" = 4.19.157-perf-v56.4+ ] || {
	echo 'Refusing direct restart outside the pinned V56.4 kernel.' >&2
	exit 3
}
actual=$(/usr/bin/sha256sum "$module" 2>/dev/null | /usr/bin/cut -d' ' -f1)
[ "$actual" = "$expected" ] || {
	echo "Refusing unexpected emergency module: $actual" >&2
	exit 4
}

echo 'Direct V56.4 bootloader restart armed; normal device shutdown is bypassed.' >&2
exec /usr/bin/insmod "$module"
