#!/bin/sh
# Bypass the downstream device_shutdown hang after a separate successful sync.
set -u

required_token=LOGS_COPIED_FORCE_BOOTLOADER
module=/usr/local/lib/tb371fc/reboot-bootloader-emergency-v56.3.ko
expected=a4075b157cb0cecdca0d08e0fa8ff4735d38912f3b56b7c2ae41b41b75c3e8f1

if [ "$#" -ne 1 ] || [ "$1" != "$required_token" ]; then
	echo "Refusing direct restart. Required token: $required_token" >&2
	exit 2
fi
[ "$(/usr/bin/uname -r)" = 4.19.157-perf-v56.3+ ] || {
	echo 'Refusing direct restart outside the pinned V56.3 kernel.' >&2
	exit 3
}
actual=$(/usr/bin/sha256sum "$module" 2>/dev/null | /usr/bin/cut -d' ' -f1)
[ "$actual" = "$expected" ] || {
	echo "Refusing unexpected emergency module: $actual" >&2
	exit 4
}

echo 'Direct bootloader restart armed; normal device shutdown is intentionally bypassed.' >&2
exec /usr/bin/insmod "$module"
